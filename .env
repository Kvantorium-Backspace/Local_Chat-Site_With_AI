# ============================================
# URL`s
# ============================================
OLLAMA_URL=http://localhost:11434
VITE_API_BASE_URL=/api

# ============================================
# НАСТРОЙКИ OLLAMA ДЛЯ ВАШЕГО ЖЕЛЕЗА
# ============================================

# 1. РАЗМЕР КОНТЕКСТА (память модели в токенах)
#    - Что это: Сколько прошлых сообщений помнит модель
#    - По умолчанию: 4096
#    - Меняйте если:
#        * Есть мощная видеокарта (RTX 3090/4090) → 8192 или 16384
#        * Диалоги очень длинные (юридические/медицинские консультации) → 16384+
#        * Видеокарта слабая (менее 8GB VRAM) → оставьте 4096
#        * Получаете ошибку "context limit exceeded" → увеличивайте
OLLAMA_NUM_CTX=4096

# 2. КОЛИЧЕСТВО GPU (сколько видеокарт используем)
#    - Что это: На сколько GPU распределить модель
#    - По умолчанию: 1
#    - Меняйте если:
#        * У вас несколько видеокарт в системе → укажите их количество (2, 4 и т.д.)
#        * Модель не влезает на одну карту → Ollama сам распределит
#        * Хотите использовать только CPU → поставьте 0
#        * Стандартный ПК с одной видеокартой → оставьте 1
OLLAMA_NUM_GPU=1

# 3. ПОТОКИ CPU (для вычислений на процессоре)
#    - Что это: Сколько ядер процессора использует модель
#    - По умолчанию: 8
#    - Меняйте если:
#        * У вас мощный процессор (8+ ядер) → увеличьте до количества ФИЗИЧЕСКИХ ядер
#        * Слабый процессор (4 ядра) → уменьшите до 4
#        * Игровой ПК (6-8 ядер) → оставьте 8
#        * Сервер с Xeon (16+ ядер) → поставьте 16
#        * Внимание: НЕ ставьте количество логических потоков (Hyper-Threading)!
OLLAMA_NUM_THREAD=4

# ============================================
# БЫСТРЫЕ РЕКОМЕНДАЦИИ ПО ЖЕЛЕЗУ
# ============================================

# СЛАБЫЙ ПК (4GB VRAM, 4-6 ядер CPU):
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_GPU=1
# OLLAMA_NUM_THREAD=4
# OLLAMA_TEMPERATURE=0.7

# СРЕДНИЙ ПК (8GB VRAM, 6-8 ядер):
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_GPU=1
# OLLAMA_NUM_THREAD=8

# МОЩНЫЙ ПК (12-24GB VRAM, 8+ ядер):
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_GPU=1
# OLLAMA_NUM_THREAD=12

# ТОПОВЫЙ (24GB+ VRAM, 16+ ядер):
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_GPU=1
# OLLAMA_NUM_THREAD=16





# ============================================
# НАСТРОЙКА ОТВЕТОВ OLLAMA 
# ============================================

# 1. ТЕМПЕРАТУРА (креативность ответов)
#    - Что это: Насколько случайны/неожиданны ответы модели
#    - Диапазон: 0.0 (строго детерминировано) до 2.0 (очень хаотично)
#    - По умолчанию: 0.7
#    - Меняйте если:
#        * Нужны фактические, точные ответы (код, математика, документация) → 0.1-0.3
#        * Обычный чат, нейтральные ответы → 0.5-0.7
#        * Творческие задачи (стихи, рассказы, идеи) → 0.8-1.2
#        * Абсурдный/креативный бред (развлечение) → 1.3-1.8
OLLAMA_TEMPERATURE=0.7

# 2. TOP_P (ядровая выборка)
#    - Что это: Отсекает маловероятные слова, оставляя топ P% вероятностей
#    - Диапазон: 0.0 (только самое вероятное слово) до 1.0 (без фильтрации)
#    - По умолчанию: 0.9
#    - Меняйте если:
#        * Нужны предсказуемые, "безопасные" ответы → 0.5-0.7
#        * Баланс между креативностью и связностью → 0.8-0.9
#        * Очень креативные/разнообразные ответы → 0.95-1.0
#        * Совет: Работает вместе с temperature, обычно не трогают
OLLAMA_TOP_P=0.9

# 3. TOP_K (ограничение словаря)
#    - Что это: Модель выбирает только из K самых вероятных следующих слов
#    - Диапазон: 1 (только самое вероятное слово) до 100+ (больше вариантов)
#    - По умолчанию: 40
#    - Меняйте если:
#        * Ответы слишком предсказуемые → увеличьте до 60-80
#        * Ответы слишком хаотичные/несвязные → уменьшите до 20-30
#        * Код/факты/точные ответы → оставьте 40
#        * Поэзия/творчество → 60-100
OLLAMA_TOP_K=40

# 4. REPEAT_PENALTY (штраф за повторения)
#    - Что это: Насколько модель избегает повторять одни и те же слова/фразы
#    - Диапазон: 1.0 (без штрафа) до 2.0 (сильно избегает повторов)
#    - По умолчанию: 1.1
#    - Меняйте если:
#        * Модель зацикливается, повторяет фразы → увеличьте до 1.2-1.5
#        * Модель говорит слишком хаотично, избегает связных фраз → уменьшите до 1.05
#        * Нормальный чат → оставьте 1.1
#        * Генерация длинных списков/перечислений → уменьшите до 1.05
OLLAMA_REPEAT_PENALTY=1.1

# ============================================
# РЕКОМЕНДАЦИИ ПО ЗАДАЧАМ
# ============================================

# ПРОГРАММИРОВАНИЕ / КОД:
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_TOP_P=0.8
# OLLAMA_NUM_CTX=8192

# ТВОРЧЕСТВО / ПИСАТЕЛЬСТВО:
# OLLAMA_TEMPERATURE=0.9
# OLLAMA_TOP_P=0.95
# OLLAMA_TOP_K=60

# ЧАТ / ОБЩЕНИЕ:
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_TOP_P=0.9
# OLLAMA_REPEAT_PENALTY=1.1

# ФАКТЫ / АНАЛИТИКА:
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_TOP_P=0.5
# OLLAMA_TOP_K=20