# Backend окружение
# Копируйте этот файл в backend/.env и отредактируйте значения

# URL Ollama сервера (локально)
OLLAMA_URL=http://localhost:11434

# Frontend окружение
# Копируйте этот файл в frontend/.env если нужно

# URL Backend API
VITE_API_BASE_URL=http://127.0.0.1:8000

# Порты (если хотите менять от стандартных)
# OLLAMA_PORT=11434
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
